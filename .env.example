# API Keys for Data Collection
# Copy this file to .env and add your actual API keys

# Yelp Fusion API
# Get your key at: https://www.yelp.com/developers
YELP_API_KEY=your_yelp_api_key_here

# Google Places API (Optional)
# Get your key at: https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=your_google_api_key_here

# US Census API (Optional)
# Get your key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# City-Specific Data Portal URLs (will be customized based on your city choice)
CITY_DATA_PORTAL_URL=
POLICE_DATA_URL=
PERMIT_DATA_URL=

# Advanced Features APIs
# Federal Reserve Economic Data (FRED) - FREE
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# GreatSchools API (Optional) - for school ratings
# Get your key at: https://www.greatschools.org/api/
GREATSCHOOLS_API_KEY=your_greatschools_api_key_here

# Walk Score API (Optional) - for walkability data
# Get your key at: https://www.walkscore.com/professional/api.php
WALKSCORE_API_KEY=your_walkscore_api_key_here
