{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Read-only delivery of public Austin snapshot data through CloudFront; private S3 origin.",
  "Resources": {
    "SnapshotOriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "spattoor-austin-snapshots",
          "Description": "Private Austin S3 snapshot origin",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SnapshotDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Read-only public Austin market snapshot, private S3 origin",
          "DefaultRootObject": "latest.json",
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "Origins": [
            {
              "Id": "AustinSnapshotS3",
              "DomainName": {
                "Fn::Sub": "${DataBucket}.s3.${AWS::Region}.amazonaws.com"
              },
              "OriginAccessControlId": {
                "Ref": "SnapshotOriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "AustinSnapshotS3",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "MinTTL": 0,
            "DefaultTTL": 0,
            "MaxTTL": 0,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            }
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "SnapshotOriginPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyCloudFrontReadOnlySnapshots",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:s3:::${DataBucket}/latest.json"
                },
                {
                  "Fn::Sub": "arn:aws:s3:::${DataBucket}/snapshots/*"
                }
              ],
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SnapshotDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "SnapshotBaseUrl": {
      "Value": {
        "Fn::Sub": "https://${SnapshotDistribution.DomainName}"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "SnapshotDistribution"
      }
    }
  },
  "Parameters": {
    "DataBucket": {
      "Type": "String",
      "Description": "Existing private S3 bucket containing public market-data snapshots."
    }
  }
}
